# База заявок. Обязательна: без неё приём заявок не работает.
# Требование ч. 5 ст. 18 152-ФЗ — сервер базы на территории России.
DATABASE_URL="postgresql://пользователь:пароль@хост:5432/prodisser"

# Прямое подключение к базе — только для миграций, только на площадках
# с пулером (Supabase, Neon). Приложение ходит через пулер из DATABASE_URL,
# а Prisma меняет схему в обход него: пулер не пропускает служебные команды.
# На своём сервере не нужен — оставить пустым.
DIRECT_URL=""

# Демонстрационный стенд: закрывает сайт от поисковиков (noindex +
# Disallow: / в robots.txt), чтобы временный адрес не попал в выдачу
# и не перебил боевой. Читается при сборке, не при запуске.
# На боевом сервере оставить пустым.
NEXT_PUBLIC_DEMO_STAND=""

# Публичный адрес сайта. Нужен для canonical и Open Graph.
NEXT_PUBLIC_SITE_URL="https://prodisser.ru"

# Telegram: мгновенное уведомление ответственного о заявке.
# Токен выдаёт @BotFather, идентификатор чата — @userinfobot или @getidsbot.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Почта: дублирующий канал и архив. Ящик на собственном домене
# у российского провайдера — см. docs/DECISIONS.md, Р-06.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ProDisser <site@prodisser.ru>"
LEAD_MAIL_TO="info@prodisser.ru"
