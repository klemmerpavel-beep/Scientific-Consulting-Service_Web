# База заявок. Обязательна: без неё приём заявок не работает.
# Требование ч. 5 ст. 18 152-ФЗ — сервер базы на территории России.
DATABASE_URL="postgresql://пользователь:пароль@хост:5432/prodisser"

# Прямое подключение к базе — только для миграций, только на площадках
# с пулером (Supabase, Neon). Приложение ходит через пулер из DATABASE_URL,
# а Prisma меняет схему в обход него: пулер не пропускает служебные команды.
# На своём сервере не нужен — оставить пустым.
DIRECT_URL=""

# Демонстрационный стенд: закрывает сайт от поисковиков (noindex +
# Disallow: / в robots.txt), чтобы временный адрес не попал в выдачу
# и не перебил боевой. Читается при сборке, не при запуске.
# На боевом сервере оставить пустым.
NEXT_PUBLIC_DEMO_STAND=""

# Публичный адрес сайта. Нужен для canonical и Open Graph.
NEXT_PUBLIC_SITE_URL="https://prodisser.ru"

# Номер счётчика Яндекс.Метрики. Пустое значение — счётчика нет: со страниц
# не уходит ни одного внешнего запроса, политика содержимого остаётся
# закрытой. Заполнять только после того, как политика дополнена сведениями
# о счётчике: её раздел «Файлы cookies и веб-аналитика» сейчас утверждает
# обратное. Читается при сборке, не при запуске.
NEXT_PUBLIC_METRIKA_ID=""

# Telegram: мгновенное уведомление ответственного о заявке.
# Токен выдаёт @BotFather, идентификатор чата — @userinfobot или @getidsbot.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Почта: дублирующий канал и архив. Ящик на собственном домене
# у российского провайдера — см. docs/DECISIONS.md, Р-06.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ProDisser <site@prodisser.ru>"
LEAD_MAIL_TO="info@prodisser.ru"

# ── Личный кабинет ──────────────────────────────────────────────────────────

# Секрет, которым подписываются свёртки одноразовых ссылок и сессий.
# Не короче 32 знаков; без него кабинет не поднимается. Смена значения
# разом обесценивает все выданные ссылки и открытые сессии — это и есть
# способ закрыть доступ всем сразу.
SESSION_SECRET=""

# Каталог для материалов на стенде разработки. В бою вместо него
# подключается S3-совместимое хранилище на территории России.
CABINET_STORAGE_DIR="./.storage"

# Секрет маршрута рассылки уведомлений. Маршрут вызывается по расписанию
# с сервера, учётной записи у расписания нет — отсюда общий секрет.
CABINET_CRON_SECRET=""

# Telegram как канал уведомлений кабинета. Имя бота нужно для ссылки
# привязки, секрет вебхука — для проверки подлинности обновлений.
# Уведомления уходят без содержания переписки: только повод заглянуть.
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
