// Хранилище заявок. Требование ч. 5 ст. 18 152-ФЗ: запись, систематизация,
// накопление и хранение персональных данных граждан РФ выполняются с
// использованием баз, находящихся на территории России. База разворачивается
// на той же площадке, что и приложение, — см. docs/DECISIONS.md, Р-04 и Р-06.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Заявка с сайта. Одна запись — одно обращение.
model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// Страница, с которой пришла заявка: landing, postgrad, students, business
  source String
  /// Форма на странице: hero, request — на случай, если форм несколько
  form   String

  name         String?
  contactKind  String // email | phone
  contact      String
  organization String?
  topic        String?
  speciality   String?
  need         String?
  deadline     String?
  direction    String?
  message      String? @db.Text

  /// Заявка из кабинета собирает больше, чем форма сайта: работу ведут с
  /// оглядкой на научного руководителя и на требования кафедры, а звонить
  /// приходится по телефону, а не по почте, которой человек вошёл
  /// (решение Р-191). Оба поля необязательны и на формы сайта не влияют.
  supervisorName String?
  phone          String?

  /// Журнал согласий: что именно отметил заявитель и в какой редакции текста
  consentGiven   Boolean
  consentVersion String
  termsAccepted  Boolean @default(false)
  marketingOptIn Boolean @default(false)
  /// Разрешение автора отзыва на публикацию его текста на Сайте. Только для
  /// формы отзыва: она не собирает ни имени, ни контакта, поэтому спросить
  /// разрешение задним числом негде — либо оно дано сразу, либо отзыв
  /// остаётся внутренним сигналом (решение Р-114).
  publishAllowed Boolean @default(false)

  /// Доказательства для проверки регулятором
  ip        String?
  userAgent String? @db.Text

  status          LeadStatus @default(NEW)
  /// Когда заявка последний раз сменила состояние — давность дела
  /// «Заявки в разборе» на «Сегодня» (требование М-06, решение Р-304).
  statusChangedAt DateTime   @default(now())
  notes           String?    @db.Text

  /// Причина отказа, которую заявитель получает письмом (решение Р-217).
  /// Отдельно от notes: notes — внутренняя пометка менеджера и наружу не
  /// выходит.
  declineReason String? @db.Text

  /// Проект, в который развёрнута одобренная заявка. Заявка не удаляется
  /// никогда — одобренная получает ссылку, отклонённая остаётся с причиной.
  projectId String?  @unique
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  deliveries    Delivery[]
  attachments   LeadAttachment[]
  /// Внутренние комментарии руководителя и менеджеров (решение Р-270).
  comments      LeadComment[]
  /// Ответ заявителю, у которого нет кабинета: письмо об отказе (Р-217).
  notifications NotificationOutbox[]

  @@index([createdAt])
  @@index([status])
  @@index([source])
}

/// Файл, приложенный к заявке из кабинета.
///
/// Материал живёт при работе, а заявка работой ещё не стала: приложить
/// файл к `Material` до одобрения некуда. Поэтому у заявки своё вложение —
/// с тем же порядком, что у версий материалов: ключ объекта не содержит
/// имени файла, размер и свёртка фиксируются при приёме, строка не
/// удаляется никогда. При одобрении заявки вложения переносятся в
/// материалы созданной работы, а `materialId` помнит куда (решение Р-191).
model LeadAttachment {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  storageKey   String @unique
  originalName String
  sizeBytes    BigInt
  sha256       String
  contentType  String

  uploadedById String?
  uploadedBy   User?    @relation("LeadAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime @default(now())

  /// Материал работы, в который вложение перенесено при одобрении.
  materialId String?
  /// Объект вычищен из хранилища: по требованию субъекта либо по сроку.
  purgedAt   DateTime?

  @@index([leadId])
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  /// Отработана, ждёт ответа заявителя: ход за ним (решение Р-270).
  AWAITING_REPLY
  CONSULTED
  CONTRACTED
  DECLINED
  SPAM
}

/// Доставка заявки в канал. Заявка сохраняется всегда, доставка может не пройти —
/// эта таблица показывает, что именно не дошло и почему.
model Delivery {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  channel   String // telegram | email
  ok        Boolean
  error     String?  @db.Text
  attempts  Int      @default(1)
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([ok])
}

// ═══════════════════════════════════════════════════════════════════════════
// Личный кабинет ProDisser
//
// Закрытый контур: клиент, эксперт, менеджер, руководитель. Решение Р-122.
//
// Три сквозных правила этого раздела:
//   1. Деньги хранятся в копейках целым числом (BigInt). Тип с плавающей
//      точкой к деньгам не применяется нигде.
//   2. Версии материалов неизменяемы: строки только вставляются и читаются.
//   3. Персональные данные клиента сведены к минимуму ч. 1 ст. 5 152-ФЗ:
//      ФИО, адрес, телефон, вуз, специальность. Канал привлечения не ведётся.
// ═══════════════════════════════════════════════════════════════════════════

enum UserRole {
  CLIENT
  EXPERT
  MANAGER
  HEAD
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  /// Данные субъекта обезличены по его требованию. Вход невозможен.
  ERASED
}

/// Учётная запись. Отделена от карточки клиента намеренно: импорт исторических
/// данных порождает клиентов, у которых входа в систему нет и может не быть.
model User {
  id       String     @id @default(cuid())
  /// Идентификатор входа. Хранится в нижнем регистре без пробелов.
  email    String     @unique
  fullName String
  role     UserRole
  status   UserStatus @default(ACTIVE)

  /// Контакты. Модуль прав отдаёт их только менеджеру и руководителю.
  phone          String?
  telegramChatId String? @unique

  notifyEmail    Boolean @default(true)
  notifyTelegram Boolean @default(false)
  /// Куратор получает письма о работах одной сводкой в 09:00 по Москве
  /// (улучшение УЭ-01, решение Р-398). Telegram — сразу.
  dailyDigest    Boolean @default(false)

  /// Согласие на обработку ПДн, принятое при первом входе в кабинет.
  /// Редакция текста хранится отдельно — тексты пересматриваются.
  consentAcceptedAt DateTime?
  consentVersion    String?

  createdAt       DateTime  @default(now())
  lastLoginAt     DateTime?
  /// Клиент закрыл блок первого входа «Как устроен кабинет» (Т-10, Р-310):
  /// блок больше не показывается.
  welcomeClosedAt DateTime?
  erasedAt        DateTime?

  clientProfile ClientProfile?
  expertProfile ExpertProfile?

  sessions    Session[]
  loginTokens LoginToken[]

  contactChannels ContactChannel[]
  notifyRules     NotifyRule[]

  managedProjects Project[] @relation("ProjectManager")
  expertProjects  Project[] @relation("ProjectExpert")
  expertStages    Stage[]   @relation("StageExpert")

  stageChanges        StageStateChange[]
  projectEvents       ProjectEvent[]
  createdMaterials    Material[]
  uploadedVersions    MaterialVersion[]
  leadAttachments     LeadAttachment[]     @relation("LeadAttachmentUploader")
  authoredComments    VersionComment[]     @relation("CommentAuthor")
  moderatedComments   VersionComment[]     @relation("CommentModerator")
  fileAccess          FileAccessLog[]
  messages            Message[]            @relation("MessageAuthor")
  staffMessages       Message[]            @relation("StaffThread")
  threadReads         MessageThreadRead[]
  practiceSettings    PracticeSetting[]
  closedChecks        HeadCheck[]
  recommendationMarks RecommendationMark[]
  assignments         Assignment[]         @relation("AssignmentAssignee")
  givenAssignments    Assignment[]         @relation("AssignmentAuthor")
  expenses            Expense[]
  payouts             ExpertPayout[]
  notifications       NotificationOutbox[]
  auditEvents         AuditEvent[]
  importBatches       ImportBatch[]
  yearlyFinance       YearlyFinance[]      @relation("YearlyFinanceAuthor")
  erasureApprovals    ErasureRequest[]
  leadComments        LeadComment[]

  @@index([role, status])
}

/// Одноразовая ссылка входа. В ссылку уходят обе части: selector.verifier.
/// Селектор даёт индексный поиск, верификатор сравнивается за постоянное
/// время. Сам верификатор в базе не хранится никогда.
enum TokenPurpose {
  LOGIN
  BIND_TELEGRAM
}

model LoginToken {
  id           String       @id @default(cuid())
  selector     String       @unique
  verifierHash String
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Назначение токена. Ссылка входа и ссылка привязки Telegram устроены
  /// одинаково, но взаимозаменяемы быть не должны: перейдя по ссылке
  /// привязки в браузере, войти нельзя.
  purpose      TokenPurpose @default(LOGIN)
  createdAt    DateTime     @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  requestIp    String?
  /// Ссылку выдал сотрудник (М-03, «Выдать ссылку»), а не сам человек
  /// запросил её на свою почту: сессия по ней помечается (ОМ-3, Р-292).
  issuedById   String?
  /// Экран, на который человек вернётся после входа: с него он пришёл на
  /// форму входа (Т-06, Р-309). Хранится в токене — вход с другого
  /// устройства ведёт туда же.
  returnPath   String?

  @@index([userId])
  @@index([expiresAt])
}

/// Попытка запросить ссылку. Ограничение частоты считается по этой таблице:
/// 5 запросов на пару «адрес + IP», 10 на адрес со всех IP (кроме узлов, где у владельца была сессия) и 20 с одного IP в час (Р-251).
model LoginAttempt {
  id              String   @id @default(cuid())
  emailNormalized String
  ip              String
  occurredAt      DateTime @default(now())
  /// sent | rate_limited | unknown_email — исход не раскрывается заявителю
  outcome         String

  @@index([emailNormalized, occurredAt])
  @@index([ip, occurredAt])
}

/// Серверная сессия. Хранится на сервере, а не в подписанном токене:
/// нужен мгновенный отзыв при обезличивании субъекта и при смене роли.
model Session {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  ip           String?
  userAgent    String?   @db.Text
  /// Сессия открыта ссылкой, которую выдал сотрудник: согласование этапа
  /// в ней записывается с пометкой (ОМ-3, решение Р-292).
  viaStaffLink Boolean   @default(false)

  @@index([userId])
  @@index([expiresAt])
}

/// Карточка клиента. Состав полей ограничен минимумом 152-ФЗ.
model ClientProfile {
  id     String  @id @default(cuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  fullName       String
  /// ФИО в нижнем регистре со схлопнутыми пробелами. Индекс неуникальный:
  /// дубли в исторических данных выявляются, а не блокируются при импорте.
  normalizedName String

  phone      String?
  email      String?
  university String?
  speciality String?
  notes      String? @db.Text

  /// Заполняется при ручном сведении дублей после импорта.
  mergedIntoId String?
  mergedInto   ClientProfile?  @relation("ClientMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   ClientProfile[] @relation("ClientMerge")

  createdAt DateTime  @default(now())
  erasedAt  DateTime?

  projects        Project[]
  erasureRequests ErasureRequest[]

  @@index([normalizedName])
  @@index([erasedAt])
}

/// Карточка эксперта. Регалии видны всем участникам проекта, в отличие от
/// контактов в User.
model ExpertProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  degree         String?
  academicTitle  String?
  position       String?
  specialization String?
  university     String?
  /// Шифр научной специальности («1.3.8»). Профиль — носитель регалий и
  /// у куратора с руководителем; права по-прежнему решает роль
  /// (требование Т-11, решение Р-297).
  specialtyCode  String?

  /// Подсказка по умолчанию для начисления. Само вознаграждение вводится
  /// суммой вручную по каждому проекту или этапу.
  defaultPayout BigInt?

  /// Договор поручения обработки ПДн (ч. 3 ст. 6 152-ФЗ). Без него модуль
  /// прав не выдаёт эксперту доступ к материалам клиента.
  ndaSignedAt    DateTime?
  /// Когда куратор нажал «Сообщить руководителю» на экране без доступа:
  /// не чаще раза в сутки; отметка договора гасит (требование Э-12,
  /// решение Р-331).
  ndaRequestedAt DateTime?

  createdAt DateTime @default(now())
}

// ───────────────────────────── Справочники ─────────────────────────────────

/// Тип сопровождения. Наполняется позициями, выведенными из истории заказов.
model ServiceType {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  basePrice BigInt?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  aliases        ServiceTypeAlias[]
  stageTemplates StageTemplate[]
  projects       Project[]
  expenses       Expense[]
}

/// Историческое написание типа работы. Сводит разнобой исходного файла
/// к позициям справочника; пополняется руководителем при импорте.
model ServiceTypeAlias {
  id            String      @id @default(cuid())
  alias         String      @unique
  serviceTypeId String
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
}

/// Шаблон этапа по типу сопровождения. Применение к проекту необязательно
/// и копирует строки в Stage: изменение шаблона живые проекты не переписывает.
model StageTemplate {
  id            String      @id @default(cuid())
  serviceTypeId String
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  title         String
  position      Int
  durationDays  Int?
  isActive      Boolean     @default(true)

  @@unique([serviceTypeId, position])
}

/// Соответствие заливки ячейки состоянию заказа. Палитра исходного файла
/// не нормирована, поэтому задаётся руководителем, а не зашита в код.
model ImportColorMap {
  argb        String  @id
  mapsTo      String
  description String?
}

/// Счётчик кодов проектов по годам. Выдача — транзакционным инкрементом:
/// два менеджера, одобряющих заявки одновременно, не получат один код.
model ProjectCodeCounter {
  year       Int @id
  lastNumber Int @default(0)
}

// ──────────────────────────── Производство ─────────────────────────────────

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

/// Роль эксперта в работе (требование Т-11, О-10, решение Р-297).
enum ExpertRole {
  SUBJECT_EXPERT
  METHODOLOGIST
  SCIENCE_EDITOR
}

enum ProjectSource {
  WEB
  IMPORT
}

/// Проект сопровождения. Единица работы, создаваемая после одобрения заявки.
model Project {
  id   String @id @default(cuid())
  /// Формат PD-ГГГГ-ННН. Выдаётся ProjectCodeCounter.
  code String @unique

  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id])

  serviceTypeId String
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])

  title String
  topic String? @db.Text

  /// Короткое описание работы для клиента: о чём она и чем закончится.
  /// Тема — формулировка исследования, а это объяснение в двух фразах
  /// (решение Р-190).
  summary String? @db.Text

  managerId String
  manager   User   @relation("ProjectManager", fields: [managerId], references: [id])

  expertId      String?
  expert        User?   @relation("ProjectExpert", fields: [expertId], references: [id], onDelete: SetNull)
  /// Текст исполнителя из импортированной строки, если он не сопоставлен
  /// с учётной записью. Такие проекты дают маржу, равную сумме договора.
  expertNameRaw String?

  status ProjectStatus @default(ACTIVE)
  source ProjectSource @default(WEB)

  startedOn       DateTime?
  dueOn           DateTime?
  closedOn        DateTime?
  /// Дата закрытия — плановый срок, а не день фактического закрытия:
  /// перенос книги заказов и ручной заказ, заведённый завершённым. По
  /// таким работам доля «в срок» не считается (требование РК-23,
  /// решение Р-355).
  closedOnPlanned Boolean   @default(false)
  /// Первая дата закрытия: повторное закрытие после возобновления её не
  /// сдвигает; «закрыто за период» считается по ней (улучшение УМ-13,
  /// решение Р-392).
  firstClosedOn   DateTime?

  /// Роль эксперта в работе — так клиент видит эксперта вместо ФИО
  /// (требование Т-11, О-10, решение Р-297). Пусто — «Эксперт по
  /// специальности».
  expertRole ExpertRole?

  /// Срок согласования этапа, рабочих дней: от 5 (п. 7.2 оферты) до 20.
  /// Действует со следующей сдачи этапа (требование Т-15, решение Р-290).
  approvalDays Int @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead          Lead?
  stages        Stage[]
  materials     Material[]
  messages      Message[]
  events        ProjectEvent[]
  contract      Contract?
  payouts       ExpertPayout[]
  notifications NotificationOutbox[]
  importRows    ImportRow[]
  assignments   Assignment[]
  headChecks    HeadCheck[]

  @@index([status, dueOn])
  @@index([clientId])
  @@index([expertId])
  @@index([managerId])
}

/// Состояние этапа. Перечень закрыт: свободный ввод состояния исключён типом
/// поля, потому что на состоянии держатся уведомления, фильтры, расчёт
/// просрочек и аналитика.
enum StageState {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_CLIENT
  IN_APPROVAL
  DONE
}

/// Этап проекта. Название — свободный текст менеджера, состояние — из перечня.
model Stage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  position Int
  title    String
  state    StageState @default(NOT_STARTED)

  dueOn         DateTime?
  /// Причина остановки открытым текстом: «ждём протокол испытаний;
  /// после загрузки — два рабочих дня работы эксперта».
  blockedReason String?   @db.Text

  /// Суть выполнения этапа: что именно делается и что человек получит.
  /// Заполняет менеджер при заведении плана — прежде этап нёс одно
  /// название, и клиент догадывался о содержании сам (решение Р-190).
  summary String? @db.Text

  /// Итог этапа: что сделано и что дальше. Куратор пишет его при переводе
  /// на согласование; клиент читает его над кнопками и в письме
  /// (требование Т-14, решение Р-289). Обезличивание затирает поле.
  outcome String? @db.Text

  expertId String?
  expert   User?   @relation("StageExpert", fields: [expertId], references: [id], onDelete: SetNull)

  /// Момент перехода в «ждём клиента». Питает светофор «ждёт клиента
  /// дольше 14 дней» у менеджера.
  awaitingClientSince DateTime?

  startedAt   DateTime?
  completedAt DateTime?

  /// Клиент вернул этап с замечаниями; гаснет при новой сдаче (Р-281).
  returnedAt  DateTime?
  /// Куратор принял замечания в работу — дело «Клиент вернул этап»
  /// закрыто (требование М-04).
  returnAckAt DateTime?

  /// Куратор сдал этап менеджеру (требование Э-05, решение Р-325). Новое
  /// состояние этапа не заводится: для клиента этап остаётся «В работе».
  /// Пометка гаснет при отзыве, при возврате менеджером, при уходе этапа из
  /// «В работе» и при замене куратора.
  handedOverAt   DateTime?
  /// «Что сделано и на что обратить внимание клиента» — записка куратора;
  /// у менеджера она — черновик «Итога этапа». Обезличивание затирает поле.
  handoverNote   String?   @db.Text
  /// Последний возврат этапа куратору менеджером и его причина.
  handbackAt     DateTime?
  handbackReason String?   @db.Text

  /// Срок согласования (требование Т-15, решение Р-290): момент сдачи и
  /// последний день срока — московский день как полночь UTC. Пока работа
  /// приостановлена, срока нет, а остаток рабочих дней лежит в
  /// `approvalDaysLeft`. Клиенту без учётной записи срок не ставится.
  approvalSentAt   DateTime?
  approvalDueOn    DateTime?
  approvalDaysLeft Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  changes   StageStateChange[]
  materials Material[]
  payouts   ExpertPayout[]
  tranches  Tranche[]
  checks    HeadCheck[]

  @@unique([projectId, position])
  @@index([state, dueOn])
  @@index([state, approvalDueOn])
}

/// История переходов состояния. Нужна аналитике длительностей и служит
/// источником событий уведомлений. Согласование этапа — переход
/// IN_APPROVAL → DONE: клиентом (`CLIENT_APPROVE`), практикой по
/// подтверждению клиента с основанием (`STAFF_FOR_CLIENT`, Р-292) или
/// по истечении срока без автора (`AUTO_ACCEPT`, Р-290).
model StageStateChange {
  id          String         @id @default(cuid())
  stageId     String
  stage       Stage          @relation(fields: [stageId], references: [id], onDelete: Cascade)
  fromState   StageState?
  toState     StageState
  actorId     String?
  actor       User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  reason      String?        @db.Text
  /// Кто и как перевёл: практика, согласование или возврат клиентом.
  via         StageChangeVia @default(MANUAL)
  /// В тексте замечаний есть телефон, почта или ссылка на мессенджер:
  /// эксперт такого текста не видит (решение Р-281, О-5).
  contactHint Boolean        @default(false)
  createdAt   DateTime       @default(now())

  @@index([stageId, createdAt])
}

enum StageChangeVia {
  MANUAL
  CLIENT_APPROVE
  CLIENT_RETURN
  /// Принят по истечении срока согласования, п. 7.3 оферты (Р-290).
  AUTO_ACCEPT
  /// Согласован практикой по подтверждению клиента (О-6, требование М-12).
  STAFF_FOR_CLIENT
}

/// Производственный календарь: дни, где рабочий день расходится с
/// правилом «понедельник–пятница без праздников ст. 112 ТК РФ» —
/// переносы выходных и рабочие субботы. Правит руководитель в
/// «Справочниках» (требование Т-15, решение Р-290).
model CalendarDay {
  /// Московский день как полночь UTC.
  day       DateTime @id
  workday   Boolean
  note      String?
  updatedAt DateTime @updatedAt
}

/// Лента событий проекта. Показывается клиенту с авторством и временем.
model ProjectEvent {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  kind      String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

// ───────────────────────────── Материалы ───────────────────────────────────

enum MaterialKind {
  STAGE_MATERIAL
  CONTRACT
  INVOICE
  ACT
  OTHER
}

/// Материал проекта. Клиент видит один материал с историей версий,
/// а не три отдельных файла.
model Material {
  id   String       @id @default(cuid())
  kind MaterialKind @default(STAGE_MATERIAL)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  stageId String?
  stage   Stage?  @relation(fields: [stageId], references: [id], onDelete: SetNull)

  /// Привязка закрывающих документов. Файл договора висит на договоре,
  /// счёт и акт — на транше.
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  trancheId  String?
  tranche    Tranche?  @relation(fields: [trancheId], references: [id], onDelete: SetNull)

  title       String
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  /// Мягкое удаление. Объекты в хранилище при этом сохраняются: физическое
  /// удаление возможно только процедурой обезличивания.
  deletedAt   DateTime?

  versions MaterialVersion[]

  @@index([projectId, deletedAt])
  @@index([stageId])
}

/// Версия материала. Строки только вставляются и читаются — функций
/// обновления и удаления в слое доступа к данным нет.
model MaterialVersion {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  number       Int
  /// Ключ объекта: projects/{id}/materials/{id}/v{n}/{uuid}. Исходное имя
  /// файла в ключ не попадает — оно может содержать ФИО.
  storageKey   String @unique
  originalName String
  sizeBytes    BigInt
  sha256       String
  contentType  String

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  /// Объект удалён из хранилища при исполнении требования субъекта.
  /// Строка остаётся ради связности истории версий.
  purgedAt DateTime?

  comments   VersionComment[]
  accessLog  FileAccessLog[]
  /// Публикация версии эксперта клиенту (Т-18, Р-294); у прочих версий
  /// строки нет.
  moderation VersionModeration?

  @@unique([materialId, number])
  @@index([materialId])
}

enum ModerationStatus {
  PENDING
  PUBLISHED
  REJECTED
}

/// Публикация версии эксперта клиенту (требование Т-18, решение Р-294).
///
/// Одна строка на версию, загруженную экспертом: клиент видит её только
/// после публикации куратором. Версии без строки — клиента, практики и
/// загруженные до решения — видны как прежде. Статус хранится, а не
/// выводится из роли загрузившего: смена роли не раскроет неопубликованное.
/// `MaterialVersion` остаётся «только вставка» (Р-122). Примечание
/// затирается обезличиванием.
model VersionModeration {
  id           String           @id @default(cuid())
  versionId    String           @unique
  version      MaterialVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  status       ModerationStatus @default(PENDING)
  decidedById  String?
  decidedAt    DateTime?
  note         String?          @db.Text
  /// В имени файла или в свойствах документа — фамилия куратора: менеджер
  /// видит предупреждение перед публикацией (улучшение УК-03, Р-396).
  identityHint Boolean          @default(false)
  createdAt    DateTime         @default(now())

  @@index([status])
}

/// Комментарий привязан к версии, а не к файлу: клиент видит, что именно
/// изменилось в этой версии и почему.
model VersionComment {
  id        String          @id @default(cuid())
  versionId String
  version   MaterialVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("CommentAuthor", fields: [authorId], references: [id])
  body     String @db.Text

  /// Комментарий эксперта создаётся со статусом PENDING и клиенту невидим
  /// до публикации менеджером. Комментарий менеджера публикуется сразу.
  moderationStatus ModerationStatus @default(PENDING)
  moderatedById    String?
  moderatedBy      User?            @relation("CommentModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt      DateTime?
  moderationNote   String?          @db.Text
  publishedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([versionId])
  @@index([moderationStatus, createdAt])
}

enum FileAccessAction {
  UPLOAD
  PRESIGN
  DOWNLOAD
  PURGE
}

/// Журнал доступа к файлам. Требование п. 7.1 брифа и ст. 19 152-ФЗ.
/// Выделен из общего журнала действий: у него иной объём и иной срок хранения.
model FileAccessLog {
  id         String           @id @default(cuid())
  versionId  String
  version    MaterialVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     FileAccessAction
  ip         String?
  userAgent  String?          @db.Text
  occurredAt DateTime         @default(now())

  @@index([versionId, occurredAt])
  @@index([userId, occurredAt])
  /// Журнал доступа без отбора — свежие строки по всей таблице; составные
  /// индексы выше на такую выборку не ложатся (решение Р-185).
  @@index([occurredAt])
  @@index([action, occurredAt])
}

// ───────────────────────────── Переписка ───────────────────────────────────

/// Сообщение в канале «клиент — менеджер». Канал один: эксперт высказывается
/// комментариями к версиям после модерации. Во внешние каналы переписка
/// не дублируется.
/// Ветка переписки (требование РК-07, решение Р-336). Куратор не участвует
/// ни в одной (Р-150, ответ ОЭ-1).
enum MessageThread {
  /// Клиент — менеджер работы; руководитель читает и пишет.
  CLIENT_MANAGER
  /// Внутренняя по работе: менеджер работы и руководитель.
  WORK_INTERNAL
  /// Руководитель — сотрудник, без работы.
  HEAD_STAFF
}

model Message {
  id        String        @id @default(cuid())
  /// Пусто только у ветки `HEAD_STAFF` — ограничение проверяется в базе.
  projectId String?
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  thread    MessageThread @default(CLIENT_MANAGER)
  /// Сотрудник ветки «руководитель — сотрудник».
  staffId   String?
  staff     User?         @relation("StaffThread", fields: [staffId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("MessageAuthor", fields: [authorId], references: [id])
  body     String @db.Text

  /// Сработал детектор телефона, адреса почты или @username. Не блокирует
  /// отправку, а помечает сообщение для менеджера.
  containsContactHint Boolean @default(false)

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([projectId, createdAt])
  /// Счётчик непрочитанного считается по работе и признаку прочтения:
  /// без этого индекса он читает всю переписку работы (решение Р-185).
  @@index([projectId, readAt])
  /// Помеченные передачей контактов — сводка менеджера: полсотни свежих
  /// строк из всей переписки практики.
  @@index([containsContactHint, createdAt])
  @@index([thread, projectId, createdAt])
  @@index([thread, staffId, createdAt])
}

/// Настройка практики «ключ — значение» (требование РК-05, решение Р-337).
model PracticeSetting {
  key         String   @id
  value       String
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @default(now())
}

/// Отметка рекомендации руководителем — «принято», «отклонено»,
/// «сделано» или «отложено» (требования РК-16, РК-17, решения Р-349,
/// Р-491). Ключ — экземпляр
/// рекомендации: `calendar:<вид>:<дата заказа>` и подобные; у следующего
/// сезона свой ключ. Отметка общая для практики.
model RecommendationMark {
  id     String                   @id @default(cuid())
  key    String                   @unique
  status RecommendationMarkStatus
  userId String?
  user   User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  at     DateTime                 @default(now())
}

enum RecommendationMarkStatus {
  DONE
  POSTPONED
  /// Принята к исполнению: дальше — поручение и «сделано» (Р-491).
  ACCEPTED
  /// Отклонена: к практике не подходит (Р-491).
  DECLINED
}

/// Поручение руководителя менеджеру или куратору (требование РК-19,
/// решение Р-352; В-19). Исполнитель переводит «в работе» и «сделано»,
/// руководитель — отзывает.
model Assignment {
  id          String           @id @default(cuid())
  assigneeId  String
  assignee    User             @relation("AssignmentAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  text        String           @db.Text
  dueOn       DateTime
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status      AssignmentStatus @default(ASSIGNED)
  createdById String?
  createdBy   User?            @relation("AssignmentAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  doneAt      DateTime?

  @@index([assigneeId, status])
  @@index([status, dueOn])
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  DONE
  WITHDRAWN
}

/// Статья расходов практики — справочник из четырёх статей (требование
/// РК-21, решение Р-353).
model ExpenseCategory {
  id       String    @id
  name     String    @unique
  position Int
  isActive Boolean   @default(true)
  expenses Expense[]
}

/// Расход практики за месяц (требование РК-21, решение Р-353). Месяц —
/// первое число по UTC; вид работ не указан — расход «общий».
model Expense {
  id            String          @id @default(cuid())
  month         DateTime
  categoryId    String
  category      ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount        BigInt
  note          String?
  serviceTypeId String?
  serviceType   ServiceType?    @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())

  @@index([month])
}

/// Курсор прочтения участника ветки (РК-07, Р-336). Ключ ветки —
/// `{ветка}:{работа или сотрудник}`.
model MessageThreadRead {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadKey String
  readAt    DateTime

  @@unique([userId, threadKey])
}

// ───────────────────────────── Финансы ─────────────────────────────────────

enum TrancheStatus {
  PLANNED
  INVOICED
  PAID
  WRITTEN_OFF
  /// Сторнирован: оплата снята — отмечена по ошибке или возвращена (Р-249)
  REVERSED
}

enum PayoutStatus {
  ACCRUED
  PAID
}

/// Договор. Механики предоплаченного баланса нет: оплата отражается траншами.
model Contract {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  number      String    @unique
  signedOn    DateTime?
  /// Сумма договора в копейках.
  totalAmount BigInt

  createdAt DateTime @default(now())

  tranches  Tranche[]
  documents Material[]
}

/// Транш по договору. Плановая позиция со статусом; дата фактического
/// поступления необязательна — у исторических строк её нет.
model Tranche {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  title       String
  amount      BigInt
  plannedDate DateTime?
  status      TrancheStatus @default(PLANNED)
  paidOn      DateTime?
  /// Этап, за который транш (требование РК-12, решение Р-338): по нему
  /// подсказка «Следующий этап не оплачен».
  stageId     String?
  stage       Stage?        @relation(fields: [stageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Material[]

  @@index([status, plannedDate])
  @@index([stageId])
}

/// Дело руководителя, которое закрывается действием (требование РК-12,
/// решение Р-338): акт после приёмки или возврата этапа, проверка договора,
/// заведённого менеджером.
enum HeadCheckKind {
  ACT_AFTER_ACCEPT
  ACT_AFTER_REOPEN
  CONTRACT_BY_MANAGER
}

model HeadCheck {
  id         String        @id @default(cuid())
  kind       HeadCheckKind
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageId    String?
  stage      Stage?        @relation(fields: [stageId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  closedAt   DateTime?
  closedById String?
  closedBy   User?         @relation(fields: [closedById], references: [id], onDelete: SetNull)
  closeNote  String?

  @@index([closedAt, createdAt])
  @@index([projectId])
}

/// Начисление эксперту. Сумма вводится вручную по этапу или по проекту.
/// Маржа не хранится: она считается как сумма договора за вычетом начислений.
model ExpertPayout {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  stageId String?
  stage   Stage?  @relation(fields: [stageId], references: [id], onDelete: SetNull)

  expertId String?
  expert   User?   @relation(fields: [expertId], references: [id], onDelete: SetNull)

  amount  BigInt
  status  PayoutStatus @default(ACCRUED)
  paidOn  DateTime?
  comment String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([expertId, status])
  /// Итоги по годам берут выплаченное по всей практике, без эксперта.
  @@index([status, paidOn])
}

// ──────────────────── Уведомления, журналы, импорт ─────────────────────────

enum NotificationChannel {
  EMAIL
  TELEGRAM
}

/// Способ связи, названный самим человеком.
///
/// Это не то же, что канал доставки уведомлений: система умеет писать
/// почтой и в Telegram, а звонить и писать в соцсетях — нет. Здесь
/// человек говорит, **как ему удобно**, чтобы практика с ним общалась;
/// куратор это видит и так и поступает (решение Р-198).
enum ContactKind {
  /// Письмо на адрес учётной записи.
  EMAIL
  /// Сообщение в Telegram.
  TELEGRAM
  /// Звонок куратора на указанный номер.
  PHONE_CALL
  /// Сообщение в мессенджере или социальной сети — по ссылке или имени.
  MESSENGER
  /// Полное сопровождение: куратор ведёт работу сам и связывается
  /// первым, не дожидаясь вопросов.
  FULL_SUPPORT
}

/// Как с человеком связываться. Строк может быть несколько, одна из них
/// помечается предпочтительной.
model ContactChannel {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind ContactKind

  /// Номер, ссылка или имя в мессенджере. У почты и полного сопровождения
  /// пусто: адрес известен из учётной записи, а сопровождение — порядок
  /// работы, а не адрес. Персональные данные: затирается по ст. 21 152-ФЗ.
  value String?

  /// Оговорка человека: «звонить после 18:00», «в выходные не писать».
  note String?

  /// Предпочтительный способ. Проверяется в коде, а не ограничением базы:
  /// при переносе предпочтения строк недолго бывает две.
  preferred Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Какое событие каким каналом приходит. Правил может не быть вовсе —
/// тогда работают общие переключатели `notifyEmail` и `notifyTelegram`.
model NotifyRule {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Вид события очереди (`STAGE_AWAITING_CLIENT` и прочие) либо `*` —
  /// правило на всё, что не названо отдельно.
  eventKind String

  channel NotificationChannel
  enabled Boolean             @default(true)

  @@unique([userId, eventKind, channel])
  @@index([userId])
}

enum NotificationState {
  PENDING
  SENT
  FAILED
  /// Устарело до отправки: закрыто без попытки (решение Р-278).
  EXPIRED
  /// Вошло в сводку куратора (улучшение УЭ-01, решение Р-398).
  MERGED
}

/// Почему строка очереди не ушла (требование РК-02, решение Р-334): дело на
/// «Сводке» и сигнал руководителю — только по отказу доставки.
enum OutboxFailure {
  /// Сервер канала отказал или не ответил после всех попыток.
  DELIVERY
  /// Получатель отключил канал, снял привязку Telegram или доступ закрыт.
  RECIPIENT_OFF
  /// У заявителя нет адреса.
  NO_ADDRESS
}

/// Очередь исходящих уведомлений. Строка пишется в той же транзакции, что и
/// само изменение: отказ почты или Telegram не откатывает бизнес-операцию,
/// а недоставленное уведомление видно руководителю.
model NotificationOutbox {
  id     String  @id @default(cuid())
  /// Адресат — учётная запись либо заявка, ровно одно из двух. Заявителю,
  /// которому отказали, учётную запись не заводят, а ответить ему надо:
  /// письмо идёт на адрес из заявки и читается оттуда в момент отправки,
  /// копия адреса здесь не хранится (решение Р-217).
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  channel   NotificationChannel
  eventKind String
  subject   String
  body      String              @db.Text
  /// Ключ дедупликации вида stage:<id>:awaiting_client:2026-09-15.
  /// Делает повторную постановку идемпотентной.
  dedupKey  String              @unique
  /// Экран события: кнопка «Открыть кабинет» в письме и ссылка сигнала
  /// ведут на него через `/cabinet/open` (Т-06, Р-309). Пусто — экран
  /// работы или кабинет.
  path      String?

  state       NotificationState @default(PENDING)
  /// Причина неудачи; задана только у `FAILED` (РК-02, Р-334).
  failure     OutboxFailure?
  attempts    Int               @default(0)
  lastError   String?           @db.Text
  scheduledAt DateTime          @default(now())
  sentAt      DateTime?
  createdAt   DateTime          @default(now())

  @@index([state, scheduledAt])
  /// Сводка очереди: ушедшее за сутки и время последней отправки.
  @@index([state, sentAt])
  @@index([leadId])
}

/// Журнал действий. Запись выполняется явным вызовом в сервисном слое:
/// неявная запись через события ORM даёт шум и теряет бизнес-смысл действия.
/// Годовой итог практики, введённый руководителем.
///
/// Рядом с ним кабинет считает свой итог из договоров и выплат, и обе
/// величины показываются в одной строке. Пока история за прошлые годы ведётся
/// в отдельной книге, а в кабинете накапливаются только новые работы, эти
/// величины расходятся — и расхождение должно быть видно, а не спрятано за
/// одним «итоговым» числом (решение Р-156).
model YearlyFinance {
  id   String @id @default(cuid())
  /// Календарный год: 2019, 2020, … Единственный ключ, второй строки за год нет.
  year Int    @unique

  /// Выручка и расходы за год в копейках — той же мерой, что суммы договоров.
  revenue BigInt
  costs   BigInt

  note String? @db.Text

  /// Кто и когда вводил: величины вводятся руками, и спорную цифру нужно
  /// уметь отнести к автору и дате.
  updatedById String?
  updatedBy   User?   @relation("YearlyFinanceAuthor", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditEvent {
  id         String   @id @default(cuid())
  occurredAt DateTime @default(now())

  actorId   String?
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole UserRole?
  actorIp   String?

  action     String
  objectType String
  objectId   String?
  projectId  String?
  /// Изменённые поля в виде «было/стало». Персональные данные сверх
  /// необходимого сюда не пишутся.
  payload    Json?

  @@index([occurredAt])
  @@index([objectType, objectId])
  @@index([actorId, occurredAt])
  @@index([projectId, occurredAt])
}

enum ErasureScope {
  PERSONAL_DATA
  PERSONAL_DATA_AND_FILES
}

/// Требование субъекта об удалении данных (ст. 14 и ст. 21 152-ФЗ).
/// Модель смешанная: первичные учётные документы сохраняются.
model ErasureRequest {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  requestedAt  DateTime     @default(now())
  approvedById String?
  approvedBy   User?        @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  executedAt   DateTime?
  scope        ErasureScope @default(PERSONAL_DATA)
  /// Отчёт об исполнении: затронутые таблицы, число строк, удалённые объекты.
  report       Json?

  @@index([clientId])
}

enum ImportBatchState {
  PARSED
  PREVIEWED
  APPLIED
  CANCELLED
}

enum ImportRowSeverity {
  OK
  WARNING
  ERROR
}

enum ImportRowAction {
  CREATE
  UPDATE
  SKIP
}

/// Загрузка книги заказов. Применение возможно только после предпросмотра.
model ImportBatch {
  id       String @id @default(cuid())
  fileName String
  sha256   String

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  state     ImportBatchState @default(PARSED)
  stats     Json?
  createdAt DateTime         @default(now())
  appliedAt DateTime?

  rows ImportRow[]
}

/// Строка загрузки. Исходные значения ячеек сохраняются целиком, включая код
/// заливки: разбор остаётся воспроизводимым и оспоримым.
model ImportRow {
  id        String      @id @default(cuid())
  batchId   String
  batch     ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber Int

  raw       Json
  parsed    Json?
  /// Естественный ключ строки: «k2|дата|ФИО|тип» (сумма в ключ не входит с
  /// решения Р-252; строки прежних загрузок хранят «дата|ФИО|тип|сумма»).
  /// Заменяет код заказа, которого в исходном файле нет. У строки, стёртой
  /// по требованию субъекта, — надгробие «erased:<sha256 основы ключа>».
  signature String?

  severity ImportRowSeverity @default(OK)
  errors   Json?
  action   ImportRowAction   @default(CREATE)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([batchId, rowNumber])
  @@index([signature])
}

/// Внутренний комментарий к заявке: что сделано, о чём договорились, чего
/// ждём. Заявителю не показывается и в письма не уходит. Удаляется вместе с
/// заявкой — по сроку хранения и по требованию субъекта (решение Р-270).
model LeadComment {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

enum FeedbackArea {
  SITE
  CABINET
}

enum FeedbackSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum FeedbackStatus {
  NEW
  IN_WORK
  FIXED
  REJECTED
}

/// Замечание о странице, оставленное кнопкой справа внизу на время запуска
/// сайта и кабинета (решение Р-403). Персональных данных здесь нет по
/// устройству, а не по договорённости: ни учётной записи, ни сессии, ни
/// адреса, ни строки браузера, ни cookies запись не знает; страница
/// хранится шаблоном без идентификаторов и ключей входа, текст с
/// телефоном, почтой или ссылкой на мессенджер не принимается. Поэтому
/// замечание не участвует в удалении данных субъекта: связать его с
/// человеком нечем.
model Feedback {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  area          FeedbackArea
  /// Шаблон пути: `/cabinet/stages/[id]`, а не адрес с идентификатором.
  pathTemplate  String
  text          String       @db.Text
  /// «телефон», «планшет», «компьютер» — по ширине окна, считает сервер.
  device        String
  viewportWidth Int?

  /// Снимок экрана — только с публичных страниц. Ключ — случайный, без
  /// исходного имени файла; тип — по сигнатуре байтов, а не по заголовку.
  screenshotKey  String?
  screenshotType String?
  screenshotSize Int?

  /// Критичность по правилам при отправке и текущая — после разбора.
  severityAuto FeedbackSeverity
  severity     FeedbackSeverity
  status       FeedbackStatus   @default(NEW)
  /// Что сделано — пишет руководитель на еженедельном разборе.
  note         String?          @db.Text
  resolvedAt   DateTime?

  @@index([status, createdAt])
  @@index([createdAt])
}
