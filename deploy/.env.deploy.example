# Публичный адрес сайта — обязателен. Участвует в сборке: canonical,
# Open Graph и карта сайта считаются от него.
NEXT_PUBLIC_SITE_URL=https://prodisser.ru

# База заявок. Пароль задать длинным и не переиспользовать.
POSTGRES_DB=prodisser
POSTGRES_USER=prodisser
POSTGRES_PASSWORD=

# Telegram: мгновенное уведомление о заявке.
# Токен — у @BotFather, идентификатор чата — у @getidsbot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Почта: дублирующий канал и архив заявок.
# Ящик на собственном домене у российского провайдера.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ProDisser <site@prodisser.ru>
LEAD_MAIL_TO=info@prodisser.ru

# ── Личный кабинет ──────────────────────────────────────────────────────────
# Секрет свёрток ссылок входа и сессий, не короче 32 знаков.
SESSION_SECRET=
# Каталог материалов до подключения S3-совместимого хранилища в России.
CABINET_STORAGE_DIR=/app/storage
# Секрет маршрута рассылки: cron дёргает его раз в минуту.
CABINET_CRON_SECRET=
# Telegram как канал уведомлений кабинета.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ── Зеркало практики на Яндекс Диске ────────────────────────────────────────
# Раз в час на Диск уходят таблицы (заявки, отзывы, работы, этапы, оплаты,
# материалы, итоги по годам) и файлы материалов. Их видно с телефона, не
# заходя на сервер. Пусто — выгрузка выключена (решения Р-155, Р-164).
#
# В таблицах и материалах персональные данные, поэтому хранилище российское и
# обработка ему поручена по договору: годится тариф для организаций, личный
# Диск — нет. Пароль — не от почты, а пароль приложения из Яндекс ID.
YANDEX_DISK_USER=
YANDEX_DISK_PASSWORD=
# Папка на Диске; создаётся сама при первой выгрузке.
YANDEX_DISK_FOLDER=ProDisser
# all — таблицы и файлы материалов, tables — только таблицы.
YANDEX_DISK_SCOPE=all
# Адрес WebDAV; по умолчанию https://webdav.yandex.ru.
YANDEX_DISK_WEBDAV=
# Путь книги заказов внутри папки практики: мост «Диск → база» раз в час
# (deploy/book-pull.sh, решение Р-202). Пусто — мост выключен.
BOOK_PULL_PATH=
