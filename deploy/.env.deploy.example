# Публичный адрес сайта — обязателен. Участвует в сборке: canonical,
# Open Graph и карта сайта считаются от него.
NEXT_PUBLIC_SITE_URL=https://prodisser.ru

# База заявок. Пароль задать длинным и не переиспользовать.
POSTGRES_DB=prodisser
POSTGRES_USER=prodisser
POSTGRES_PASSWORD=

# Telegram: мгновенное уведомление о заявке.
# Токен — у @BotFather, идентификатор чата — у @getidsbot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Почта: дублирующий канал и архив заявок.
# Ящик на собственном домене у российского провайдера.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ProDisser <site@prodisser.ru>
LEAD_MAIL_TO=info@prodisser.ru

# ── Личный кабинет ──────────────────────────────────────────────────────────
# Секрет свёрток ссылок входа и сессий, не короче 32 знаков.
SESSION_SECRET=
# Каталог материалов до подключения S3-совместимого хранилища в России.
CABINET_STORAGE_DIR=/app/storage
# Секрет маршрута рассылки: cron дёргает его раз в минуту.
CABINET_CRON_SECRET=
# Telegram как канал уведомлений кабинета.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
