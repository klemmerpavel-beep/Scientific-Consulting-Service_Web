# Публичный адрес сайта — обязателен. Участвует в сборке: canonical,
# Open Graph и карта сайта считаются от него.
NEXT_PUBLIC_SITE_URL=https://prodisser.ru

# База заявок. Пароль задать длинным и не переиспользовать.
POSTGRES_DB=prodisser
POSTGRES_USER=prodisser
POSTGRES_PASSWORD=

# Telegram: сигнал о заявке — страница, форма, время, номер. Содержания
# заявки в нём нет намеренно: мессенджер работает за пределами России
# (docs/DECISIONS.md, Р-52). Токен — у @BotFather, идентификатор чата —
# у @getidsbot. Канал необязательный: без него заявка всё равно придёт
# на почту и сохранится в базе.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Почта: основной канал доставки — здесь приходит содержание заявки.
# Ящик обязательно на собственном домене у российского провайдера:
# зарубежный сервис означал бы трансграничную передачу, которой политика
# не допускает. Порядок настройки — docs/HOSTING.md, шаг 6.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ProDisser <site@prodisser.ru>
LEAD_MAIL_TO=info@prodisser.ru
